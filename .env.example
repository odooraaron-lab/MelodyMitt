# Copy to .env.local for local dev. On Vercel, add these under Project > Settings > Environment Variables.

# Public URL of the site (no trailing slash). Change when the domain is bought.
NEXT_PUBLIC_SITE_URL=https://melodymitt.vercel.app

# Neon Postgres (added automatically if you connect Neon through the Vercel Marketplace)
DATABASE_URL=

# Vercel Blob for photos (added automatically when you create a Blob store in the Vercel project)
BLOB_READ_WRITE_TOKEN=

# Stripe (same account as your other projects)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend for order emails
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Melody Mitt <orders@melodymitt.co.nz>"
EMAIL_FROM=
# Where Melody's "you made a sale" emails go
OWNER_EMAIL=

# /admin login
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Any long random string, e.g. output of: openssl rand -base64 32
SESSION_SECRET=
